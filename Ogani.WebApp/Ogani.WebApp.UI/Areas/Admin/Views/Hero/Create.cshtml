@using Ogani.WebApp.DTOs.HeroDTO
@model HeroCreateDTO

@section Styles {
    <link rel="stylesheet" href="~/admin/css/custom/image-upload.css" />
}

<div class="container-fluid pt-4">
    <div class="card mb-4 col-md-8 mx-auto shadow-sm border-0 rounded-lg">
        <div class="card-header py-3 bg-white border-bottom-0">
            <h6 class="m-0 font-weight-bold text-primary">Create New Hero Banner</h6>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post" enctype="multipart/form-data">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group mb-3">
                    <label asp-for="Title" class="font-weight-bold"></label>
                    <input asp-for="Title" class="form-control" placeholder="e.g. Vegetable 100% Organic" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Subtitle" class="font-weight-bold"></label>
                    <input asp-for="Subtitle" class="form-control" placeholder="e.g. FRUIT FRESH" />
                    <span asp-validation-for="Subtitle" class="text-danger small"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Description" class="font-weight-bold"></label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Free Pickup and Delivery Available"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="ButtonText" class="font-weight-bold"></label>
                        <input asp-for="ButtonText" class="form-control" placeholder="e.g. SHOP NOW" />
                        <span asp-validation-for="ButtonText" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 form-group mb-3">
                        <label asp-for="ButtonUrl" class="font-weight-bold"></label>
                        <input asp-for="ButtonUrl" class="form-control" placeholder="e.g. /shop" />
                        <span asp-validation-for="ButtonUrl" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Image Upload with Custom JS Preview -->
                <div class="form-group mb-3">
                    <label asp-for="Image" class="font-weight-bold d-block"></label>

                    <div class="image-preview-container mb-2 text-center p-2 rounded position-relative"
                         onclick="triggerFileInput(this.parentNode);">

                        <img src="#"
                             alt="Hero Image"
                             class="d-none image-preview-img" />

                        <div class="upload-placeholder text-center">
                            <i class="fas fa-plus fa-1x text-muted opacity-50 mb-1 d-block"></i>
                            <span class="d-block text-muted opacity-75 upload-placeholder-text">Add Hero Image</span>
                        </div>

                        <button type="button"
                                class="btn btn-danger btn-sm position-absolute d-none remove-img-btn"
                                onclick="removeSelectedImage(this, event);"
                                title="Remove Image">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>

                    <input asp-for="Image" type="file" accept="image/*" class="d-none" onchange="previewImage(this);" />
                    <span asp-validation-for="Image" class="text-danger small d-block"></span>
                </div>

                <hr />

                <div class="d-flex justify-content-end">
                    <a asp-action="Index" class="btn btn-secondary rounded-pill px-4 mr-2">Cancel</a>
                    <button type="submit" class="btn btn-success rounded-pill px-4">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/admin/js/custom/common/image-upload.js"></script>
}