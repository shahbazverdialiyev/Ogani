@using Ogani.WebApp.DTOs.HeroDTO
@model IEnumerable<HeroReadDTO>

@{
    ViewData["Title"] = "Hero Banner Management";
    var inactiveHeroes = Model.Where(x => !x.IsActive);
}

<link rel="stylesheet" href="~/assets/css/style.css" />


<div class="container pt-4 px-4">

    <div class="card p-2 mb-5 shadow-sm border-0">
        <div class="card-header mb-5 bg-dark text-white d-flex justify-content-between align-items-center py-3">
            <h5 class="mb-0 text-white"><i class="fas fa-eye mr-1"></i>  Current Active Hero (Live Preview)</h5>
            <span class="badge bg-success px-2 py-1">Active</span>
        </div>
        <div class="card-body col-lg-9 mx-auto mb-5 p-0 overflow-hidden border">
            @await Component.InvokeAsync("Hero")
        </div>
    </div>

    <hr />

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="text-dark">Other Heros</h4>
            <p class="text-muted mb-0">which ones you can activate</p>
        </div>

        <a asp-action="Create" class="btn btn-success px-4">
            <i class="fas fa-plus mr-1"></i> New Hero
        </a>
    </div>

    @if (!inactiveHeroes.Any())
    {
        <div class="alert alert-info text-center py-4">
            <i class="bi bi-info-circle display-6 d-block mb-2"></i>
            No Another Hero
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var hero in inactiveHeroes)
            {
                <div class="col-lg-6 mb-5">
                    <div class="card h-100 shadow-sm border-0 overflow-hidden">

                        <div class="hero__item position-relative" style="background-image: url('@hero.ImageUrl'); height: 260px; background-size: cover; background-position: center; padding-left: 35px;">
                            <div class="hero__text" style="transform: scale(0.85); transform-origin: left center;">
                                <span>@hero.Subtitle</span>
                                <h2 style="font-size: 32px; line-height: 38px;">@Html.Raw(hero.Title?.Replace("\n", "<br />"))</h2>
                                @if (!string.IsNullOrEmpty(hero.Description))
                                {
                                    <p class="mb-3">@hero.Description</p>
                                }
                                <span class="primary-btn text-white fs-6 py-2 px-3">@hero.ButtonText</span>
                            </div>
                        </div>

                        <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center py-3">
                            <form asp-action="SetActive" asp-route-id="@hero.Id" method="post">
                                <button type="submit" class="btn btn-sm btn-success px-3">
                                    <i class="fas fa-power"></i> Set Active
                                </button>
                            </form>

                            <div class="d-flex gap-2">
                                <a asp-action="Update" asp-route-id="@hero.Id" class="btn btn-sm btn-outline-warning mr-1" title="edit">
                                    <i class="fas fa-edit"></i>
                                </a>

                                <form asp-action="Delete" asp-route-id="@hero.Id" method="post" onsubmit="return confirm('Bu Hero-nu silməkdən əminsiniz?');" title="delete">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </form>
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
</div>