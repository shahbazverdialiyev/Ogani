@using Ogani.WebApp.DTOs.UsefulLinkDTO
@model IEnumerable<UsefulLinkReadDTO>

@{
    ViewData["Title"] = "Useful Links";
}

<div class="container-fluid pt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="h3 mb-0 text-gray-800 font-weight-bold">Useful Links</h3>
        <a asp-action="Create" class="btn btn-success rounded-pill px-4">
            <i class="fas fa-plus mr-1"></i> Add Link
        </a>
    </div>

    <div class="card mb-4 shadow-sm border-0 rounded-lg">
        <div class="card-header py-3 bg-white border-bottom-0 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">Useful Link Items</h6>
        </div>
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="alert alert-info text-center m-0">
                    No useful links found.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle text-center" width="100%" cellspacing="0">
                        <thead class="thead-light">
                            <tr>
                                <th style="width: 60px;" class="text-center">#</th>
                                <th>Name</th>
                                <th>Section</th>
                                <th>URL</th>
                                <th style="width: 100px;" class="text-center">Status</th>
                                <th class="text-center" style="width: 150px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center font-weight-bold align-middle text-primary">
                                        <i class="fas fa-link"></i>
                                        </td>
                                    <td class="font-weight-bold align-middle">@item.Name</td>
                                    <td class="align-middle">
                                        <span class="badge badge-info px-2 py-1">@item.Section</span>
                                    </td>
                                    <td class="align-middle">
                                        <a href="@item.Url" target="_blank" class="text-decoration-none">
                                            @item.Url <i class="fas fa-external-link-alt text-xs ml-1"></i>
                                        </a>
                                    </td>
                                    <td class="text-center align-middle">
                                        <span class="badge @(item.Status? "badge-success":"badge-danger") px-2 py-1">
                                            @(item.Status ? "Active" : "Deactive")
                                        </span>
                                    </td>
                                    <td class="text-center align-middle">
                                        <a asp-action="Detail" asp-route-id="@item.Id" class="btn btn-info btn-circle btn-sm mr-1" title="Detail">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Update" asp-route-id="@item.Id" class="btn btn-warning btn-circle btn-sm mr-1 text-white" title="Edit">
                                            <i class="fas fa-pencil-alt"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this link?');">
                                            <button type="submit" class="btn btn-danger btn-circle btn-sm" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>