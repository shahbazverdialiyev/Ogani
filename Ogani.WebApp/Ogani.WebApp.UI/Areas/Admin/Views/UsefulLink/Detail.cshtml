@using Ogani.WebApp.DTOs.UsefulLinkDTO
@model UsefulLinkReadDTO

@{
    ViewData["Title"] = "Useful Link Details";
}

<div class="container-fluid pt-4">
    <div class="row justify-content-center">
        <div class="col-md-7">

            <div class="card shadow-sm border-0 rounded-lg overflow-hidden mb-4">

                <!-- Visual Header -->
                <div class="bg-primary p-4 text-center text-white">
                    <div class="d-inline-flex align-items-center justify-content-center bg-white text-primary rounded-circle shadow-sm mb-2" style="width: 70px; height: 70px;">
                        <i class="fas fa-link fa-2x"></i>
                    </div>
                    <h4 class="font-weight-bold mb-0">@Model.Name</h4>
                </div>

                <!-- Body -->
                <div class="card-body p-4 bg-white">

                    <!-- Status & Created Date -->
                    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-circle @(Model.Status ? "text-success" : "text-danger") mr-2" style="font-size: 10px;"></i>
                            <span class="font-weight-bold text-uppercase text-xs text-muted mr-2">Status:</span>
                            <span class="badge @(Model.Status ? "badge-soft-success" : "badge-soft-danger") px-3 py-1 font-weight-normal">@(Model.Status ? "Active" : "Deactive")</span>
                        </div>
                        <div class="d-flex align-items-center text-muted text-xs">
                            <i class="far fa-calendar-alt mr-1"></i>
                            <span class="font-weight-bold mr-1">Created:</span>
                            <span>@Model.CreatedDate.ToString("dd MMM yyyy, HH:mm")</span>
                        </div>
                    </div>

                    <!-- Section Box -->
                    <div class="p-3 bg-light rounded-lg border-left-info shadow-xs mb-3">
                        <div class="d-flex align-items-center mb-1">
                            <i class="fas fa-layer-group text-info mr-2"></i>
                            <span class="font-weight-bold text-uppercase text-xs text-muted">Section</span>
                        </div>
                        <div class="pl-4 pt-1">
                            <span class="h6 mb-0 text-dark font-weight-bold">@Model.Section</span>
                        </div>
                    </div>

                    <!-- URL Box -->
                    <div class="p-3 bg-light rounded-lg border-left-primary shadow-xs mb-3">
                        <div class="d-flex align-items-center mb-1">
                            <i class="fas fa-globe text-primary mr-2"></i>
                            <span class="font-weight-bold text-uppercase text-xs text-muted">Target URL</span>
                        </div>
                        <div class="pl-4 pt-1">
                            <a href="@Model.Url" target="_blank" class="h6 mb-0 text-primary font-weight-bold text-break">
                                @Model.Url <i class="fas fa-external-link-alt text-xs ml-1"></i>
                            </a>
                        </div>
                    </div>

                </div>

                <!-- Footer Actions -->
                <div class="card-footer bg-white border-0 p-4 d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="fas fa-arrow-left mr-1"></i> Back to List
                    </a>

                    <div>
                        <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-warning text-white rounded-pill px-4 mr-2 shadow-sm">
                            <i class="fas fa-pencil-alt mr-1"></i> Edit
                        </a>

                        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this link?');">
                            <button type="submit" class="btn btn-danger rounded-pill px-4 shadow-sm">
                                <i class="fas fa-trash mr-1"></i> Delete
                            </button>
                        </form>
                    </div>
                </div>

            </div>

        </div>
    </div>
</div>