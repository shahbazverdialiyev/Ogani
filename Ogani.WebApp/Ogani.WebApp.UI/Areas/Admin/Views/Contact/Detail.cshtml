@using Ogani.WebApp.DTOs.ContactDTO
@model ContactDetailReadDTO

@{
    ViewData["Title"] = "Contact Details";
}

<div class="container-fluid pt-4">
    <div class="row justify-content-center">
        <div class="col-md-7">

            <!-- Main Card -->
            <div class="card shadow-sm border-0 rounded-lg overflow-hidden mb-4">

                <!-- Top Visual Header -->
                <div class="bg-primary p-4 text-center text-white position-relative">
                    <div class="mb-2">
                        @if (!string.IsNullOrEmpty(Model.Icon))
                        {
                            <div class="d-inline-flex align-items-center justify-content-center bg-white text-primary rounded-circle shadow-sm" style="width: 80px; height: 80px;">
                                <i class="@Model.Icon fa-2x"></i>
                            </div>
                        }
                        else
                        {
                            <div class="d-inline-flex align-items-center justify-content-center bg-white text-secondary rounded-circle shadow-sm" style="width: 80px; height: 80px;">
                                <i class="fas fa-address-card fa-2x"></i>
                            </div>
                        }
                    </div>
                    <h4 class="font-weight-bold mb-1">@Model.Title</h4>
                </div>

                <!-- Card Content Body -->
                <div class="card-body p-4 bg-white">

                    <!-- Info Badges (Status & Date) -->
                    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-circle @(Model.Status ? "text-success" : "text-danger") mr-2" style="font-size: 10px;"></i>
                            <span class="font-weight-bold text-uppercase text-xs text-muted mr-2">Status:</span>
                            <span class="badge @(Model.Status ? "badge-soft-success" : "badge-soft-danger") px-3 py-1 font-weight-normal">@(Model.Status? "Active":"Deactive")</span>
                        </div>
                        <div class="d-flex align-items-center text-muted text-xs">
                            <i class="far fa-calendar-alt mr-1"></i>
                            <span class="font-weight-bold mr-1">Created:</span>
                            <span>@Model.CreatedDate.ToString("dd MMM yyyy, HH:mm")</span>
                        </div>
                    </div>

                    <!-- Content Block -->
                    <div class="p-3 mb-3 bg-light rounded-lg border-left-primary shadow-xs">
                        <div class="d-flex align-items-center mb-1">
                            <i class="fas fa-align-left text-primary mr-2"></i>
                            <span class="font-weight-bold text-uppercase text-xs text-muted">Content / Detail</span>
                        </div>
                        <p class="h6 mb-0 text-gray-800 font-weight-normal pl-4 pt-1">
                            @Model.Content
                        </p>
                    </div>

                    <!-- Icon Class Name Block -->
                    <div class="p-3 bg-light rounded-lg border-left-info shadow-xs">
                        <div class="d-flex align-items-center mb-1">
                            <i class="fas fa-code text-info mr-2"></i>
                            <span class="font-weight-bold text-uppercase text-xs text-muted">FontAwesome Icon Class</span>
                        </div>
                        <div class="pl-4 pt-1">
                            @if (!string.IsNullOrEmpty(Model.Icon))
                            {
                                <code class="h6 mb-0 text-info font-weight-bold">@Model.Icon</code>
                            }
                            else
                            {
                                <span class="text-muted font-italic">No Icon Assigned</span>
                            }
                        </div>
                    </div>

                </div>

                <!-- Card Footer Actions -->
                <div class="card-footer bg-white border-0 p-4 d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="fas fa-arrow-left mr-1"></i> Back to List
                    </a>

                    <div class="d-flex gap-2">
                        <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-warning text-white rounded-pill px-4 mr-2 shadow-sm">
                            <i class="fas fa-pencil-alt mr-1"></i> Edit
                        </a>

                        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this contact item?');">
                            <button type="submit" class="btn btn-danger rounded-pill px-4 shadow-sm">
                                <i class="fas fa-trash mr-1"></i> Delete
                            </button>
                        </form>
                    </div>
                </div>

            </div>

        </div>
    </div>
</div>