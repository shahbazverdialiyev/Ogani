@using Ogani.WebApp.DTOs.ContactDTO
@model IEnumerable<ContactReadDTO>

@{
    ViewData["Title"] = "Contacts";
}

<div class="container-fluid pt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="h3 mb-0 text-gray-800 font-weight-bold">Contacts</h3>
        <a asp-action="Create" class="btn btn-success rounded-pill px-4">
            <i class="fas fa-plus mr-1"></i> Add New
        </a>
    </div>

    <div class="card mb-4 shadow-sm border-0 rounded-lg">
        <div class="card-header py-3 bg-white border-bottom-0 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">Contact Items</h6>
        </div>
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="alert alert-info text-center m-0">
                    No contact items found.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle" width="100%" cellspacing="0">
                        <thead class="thead-light">
                            <tr>
                                <th style="width: 70px;" class="text-center">Icon</th>
                                <th>Title</th>
                                <th>Content</th>
                                <th style="width: 100px;" class="text-center">Status</th>
                                <th class="text-center" style="width: 150px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center align-middle">
                                        @if (!string.IsNullOrEmpty(item.Icon))
                                        {
                                            <i class="@item.Icon fa-lg text-primary"></i>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">N/A</span>
                                        }
                                    </td>
                                    <td class="font-weight-bold align-middle">@item.Title</td>
                                    <td class="align-middle">@item.Content</td>
                                    <td class="text-center align-middle">
                                        <span class="badge @(item.Status? "badge-success":"badge-danger") px-2 py-1">
                                            @(item.Status ? "Active" : "Deactive")
                                        </span>
                                    </td>
                                    <td class="text-center align-middle">
                                        <a asp-action="Detail" asp-route-id="@item.Id" class="btn btn-info btn-circle btn-sm mr-1" title="Detail">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Update" asp-route-id="@item.Id" class="btn btn-warning btn-circle btn-sm mr-1 text-white" title="Edit">
                                            <i class="fas fa-pencil-alt"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this contact item?');">
                                            <button type="submit" class="btn btn-danger btn-circle btn-sm" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>