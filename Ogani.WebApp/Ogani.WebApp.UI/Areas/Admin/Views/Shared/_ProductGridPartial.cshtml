@model IEnumerable<dynamic>

<link rel="stylesheet" href="~/admin/css/custom/product-grid.css" asp-append-version="true" />

@{
    var productsList = Model?.ToList() ?? new List<dynamic>();
    int initialShowCount = ViewData["InitialShowCount"] != null
        ? Convert.ToInt32(ViewData["InitialShowCount"])
        : 5;
}

@if (productsList.Any())
{
    <div class="d-flex flex-wrap product-grid-container">
        @for (int i = 0; i < productsList.Count; i++)
        {
            var product = productsList[i];
            var isHidden = i >= initialShowCount;

            <div class="card shadow-sm border rounded overflow-hidden product-card @(isHidden ? "d-none" : "")">

                <!-- Product Image -->
                <div class="position-relative overflow-hidden rounded-top product-img-wrapper">
                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                    {
                        <img src="@product.ImageUrl"
                             class="card-img-top w-100 h-100"
                             alt="@product.Name"
                             loading="lazy" />
                    }
                    else
                    {
                        <div class="w-100 h-100 bg-white d-flex align-items-center justify-content-center border-bottom">
                            <i class="fas fa-box fa-2x text-muted opacity-50"></i>
                        </div>
                    }
                </div>

                <!-- Product Details -->
                <div class="card-body p-2 d-flex flex-column justify-content-between product-card-body">
                    <h6 class="font-weight-bold text-dark mb-2 text-truncate small product-title" title="@product.Name">
                        @product.Name
                    </h6>

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-success font-weight-bold small">
                            $@product.Price
                        </span>

                        <span class="badge badge-light border text-muted small px-2 py-1">
                            <i class="fas fa-cubes mr-1"></i>@product.Quantity
                        </span>
                    </div>

                    <a asp-controller="Product"
                       asp-action="Detail"
                       asp-route-id="@product.Id"
                       class="btn btn-outline-primary btn-sm btn-block py-1 product-btn-view">
                        <i class="fas fa-eye mr-1"></i> View
                    </a>
                </div>
            </div>
        }

        <!-- MORE CARD -->
        @if (productsList.Count > initialShowCount)
        {
            <div onclick="loadMoreItems(this, 18, 'products')"
                 class="card shadow-sm border rounded text-decoration-none d-flex flex-column align-items-center justify-content-center bg-light text-primary product-more-card">

                <div class="rounded-circle bg-white shadow-sm p-3 mb-2 border text-center">
                    <i class="fas fa-arrow-right fa-2x text-primary"></i>
                </div>
                <span class="font-weight-bold h6 mb-1 text-primary">MORE</span>
                <span class="small text-muted remaining-count">+@(productsList.Count - initialShowCount) products</span>
            </div>
        }
    </div>
}