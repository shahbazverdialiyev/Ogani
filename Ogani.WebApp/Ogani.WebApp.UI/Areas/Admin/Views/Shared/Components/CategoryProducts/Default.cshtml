@using Ogani.WebApp.UI.Areas.Admin.ViewModels
@model CategoryProductsVM

@{
    var categoryId = Model.CategoryId ?? Model!.Products.FirstOrDefault()?.CategoryId;
    var productsList = Model!.Products.ToList();
    int initialShowCount = 5;
}

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-primary">
            Products in this Category (@productsList.Count)
        </h6>
        @if (productsList.Count > initialShowCount && categoryId != null)
        {
            <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@categoryId" class="btn btn-sm btn-link text-primary font-weight-bold p-0">
                View All (@productsList.Count) <i class="fas fa-arrow-right ml-1"></i>
            </a>
        }
    </div>

    <div class="card-body p-3">
        @if (productsList.Any())
        {
            <partial name="_ProductGridPartial" model="Model.Products" />
        }
        else
        {
            <div class="text-center py-4 text-muted">
                <i class="fas fa-boxes fa-2x mb-2 opacity-50 d-block"></i>
                <span class="small">No products found in this category.</span>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/admin/js/load-more.js" asp-append-version="true"></script>
}