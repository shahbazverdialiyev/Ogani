@using Ogani.WebApp.UI.Areas.Admin.ViewModels
@model DiscountProductsVM

@{
    var discountId = Model.DiscountId;
    var productsList = Model!.Products.ToList();
    int initialShowCount = 5;
}


<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex justify-content-between align-items-center bg-white border-bottom">
        <h6 class="m-0 font-weight-bold text-primary">
            Products in this Discount (@productsList.Count)
        </h6>

        <div class="d-flex align-items-center gap-2">
            <a asp-controller="Discount"
               asp-action="ManageProducts"
               asp-route-discountId="@discountId"
               class="btn btn-sm btn-outline-primary rounded-pill px-3 font-weight-bold shadow-sm mr-2">
                <i class="fas fa-edit mr-1"></i> Manage Products
            </a>

            @if (productsList.Count > initialShowCount && discountId != null)
            {
                <a asp-controller="Product" asp-action="Index" asp-route-discountId="@discountId" class="btn btn-sm btn-link text-primary font-weight-bold p-0">
                    View All (@productsList.Count) <i class="fas fa-arrow-right ml-1"></i>
                </a>
            }
        </div>
    </div>

    <div class="card-body p-3">
        @if (productsList.Any())
        {
            <partial name="_ProductGridPartial" model="Model.Products" />
        }
        else
        {
            <div class="text-center py-4 text-muted">
                <i class="fas fa-boxes fa-2x mb-2 opacity-50 d-block"></i>
                <span class="small d-block mb-3">No products found in this discount.</span>
                <a asp-controller="Discount"
                   asp-action="ManageProducts"
                   asp-route-id="@discountId"
                   class="btn btn-sm btn-primary rounded-pill px-4">
                    <i class="fas fa-plus mr-1"></i> Add Products
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/admin/js/load-more.js" asp-append-version="true"></script>
}