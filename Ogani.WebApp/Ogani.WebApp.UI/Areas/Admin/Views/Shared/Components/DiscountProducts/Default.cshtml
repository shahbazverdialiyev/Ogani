@using Ogani.WebApp.UI.Areas.Admin.ViewModels
@model DiscountProductsVM

@{
    var discountId = Model.DiscountId;
    var productsList = Model!.Products.ToList();
    int initialShowCount = 5;
}

<div class="card shadow mb-4">
    <!-- Card Header -->
    <div class="card-header py-3 d-flex justify-content-between align-items-center bg-white border-bottom">
        <h6 class="m-0 font-weight-bold text-primary">
            Products in this Discount (@productsList.Count)
        </h6>

        <div class="d-flex align-items-center gap-2">
            <!-- Manage Products Düyməsi (Yuxarı sağ künc) -->
            <a asp-controller="Discount"
               asp-action="ManageProducts"
               asp-route-discountId="@discountId"
               class="btn btn-sm btn-outline-primary rounded-pill px-3 font-weight-bold shadow-sm mr-2">
                <i class="fas fa-edit mr-1"></i> Manage Products
            </a>

            @if (productsList.Count > initialShowCount && discountId != null)
            {
                <a asp-controller="Product" asp-action="Index" asp-route-discountId="@discountId" class="btn btn-sm btn-link text-primary font-weight-bold p-0">
                    View All (@productsList.Count) <i class="fas fa-arrow-right ml-1"></i>
                </a>
            }
        </div>
    </div>

    <div class="card-body p-3">
        @if (productsList.Any())
        {
            <div class="d-flex flex-wrap gap-3" id="discount-products-container" style="gap: 15px;">

                @for (int i = 0; i < productsList.Count; i++)
                {
                    var product = productsList[i];
                    var isHidden = i >= initialShowCount;

                    <div class="card shadow-sm border rounded overflow-hidden discount-product-item @(isHidden ? "d-none" : "")"
                         style="width: 180px; flex: 0 0 180px;">

                        <!-- Product Image -->
                        <div class="position-relative overflow-hidden rounded-top" style="height: 180px; width: 180px;">
                            @if (!string.IsNullOrEmpty(product.ImageUrl))
                            {
                                <img src="@product.ImageUrl"
                                     class="card-img-top w-100 h-100"
                                     alt="@product.Name"
                                     style="object-fit: cover;"
                                     loading="lazy" />
                            }
                            else
                            {
                                <div class="w-100 h-100 bg-white d-flex align-items-center justify-content-center border-bottom">
                                    <i class="fas fa-box fa-2x text-muted opacity-50"></i>
                                </div>
                            }
                        </div>

                        <!-- Product Details -->
                        <div class="card-body p-2 d-flex flex-column justify-content-between" style="background: #fff;">
                            <h6 class="font-weight-bold text-dark mb-2 text-truncate small" title="@product.Name" style="max-width: 165px;">
                                @product.Name
                            </h6>

                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-success font-weight-bold small">
                                    $@product.Price
                                </span>

                                <span class="badge badge-light border text-muted small px-2 py-1">
                                    <i class="fas fa-cubes mr-1"></i>@product.Quantity
                                </span>
                            </div>

                            <a asp-controller="Product"
                               asp-action="Detail"
                               asp-route-id="@product.Id"
                               class="btn btn-outline-primary btn-sm btn-block py-1"
                               style="font-size: 0.75rem;">
                                <i class="fas fa-eye mr-1"></i> View
                            </a>
                        </div>
                    </div>
                }

                <!-- MORE CARD (Kliklədikdə növbəti məhsulları göstərir) -->
                @if (productsList.Count > initialShowCount)
                {
                    <div id="btn-discount-load-more"
                         onclick="loadMoreDiscountProducts()"
                         class="card shadow-sm border rounded text-decoration-none d-flex flex-column align-items-center justify-content-center bg-light text-primary hover-shadow"
                         style="width: 180px; flex: 0 0 180px; min-height: 270px; cursor: pointer; transition: all 0.3s ease;">

                        <div class="rounded-circle bg-white shadow-sm p-3 mb-2 border text-center">
                            <i class="fas fa-arrow-right fa-2x text-primary"></i>
                        </div>
                        <span class="font-weight-bold h6 mb-1 text-primary">MORE</span>
                        <span class="small text-muted" id="discount-remaining-count">+@(productsList.Count - initialShowCount) products</span>
                    </div>
                }

            </div>
        }
        else
        {
            <!-- Əgər heç bir məhsul yoxdursa, birbaşa Manage Products-a yönləndirən xüsusi blok -->
            <div class="text-center py-4 text-muted">
                <i class="fas fa-boxes fa-2x mb-2 opacity-50 d-block"></i>
                <span class="small d-block mb-3">No products found in this discount.</span>
                <a asp-controller="Discount"
                   asp-action="ManageProducts"
                   asp-route-id="@discountId"
                   class="btn btn-sm btn-primary rounded-pill px-4">
                    <i class="fas fa-plus mr-1"></i> Add Products
                </a>
            </div>
        }
    </div>
</div>

<!-- JavaScript Logic -->
<script>
    function loadMoreDiscountProducts() {
        const hiddenProducts = document.querySelectorAll('.discount-product-item.d-none');
        const chunkSize = 20;

        for (let i = 0; i < chunkSize && i < hiddenProducts.length; i++) {
            hiddenProducts[i].classList.remove('d-none');
        }

        const remainingHidden = document.querySelectorAll('.discount-product-item.d-none');
        const remainingCounter = document.getElementById('discount-remaining-count');

        if (remainingHidden.length > 0) {
            if (remainingCounter) {
                remainingCounter.innerText = '+' + remainingHidden.length + ' products';
            }
        } else {
            const loadMoreBtn = document.getElementById('btn-discount-load-more');
            if (loadMoreBtn) {
                loadMoreBtn.classList.add('d-none');
            }
        }
    }
</script>