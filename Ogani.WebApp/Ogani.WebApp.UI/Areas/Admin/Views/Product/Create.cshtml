@using Ogani.WebApp.DTOs.ProductDTO
@model ProductCreateDTO
<div class="container-fluid">
    <div class="card mb-4 col-md-8 mx-auto">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Create New Product</h6>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post" enctype="multipart/form-data">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <partial name="_ProductForm" model="Model" />

                <div class="form-group mb-3">
                    <label asp-for="Image" class="font-weight-bold d-block"></label>

                    <div class="image-preview-container mb-2 text-center p-2 border rounded bg-light position-relative"
                         style="width: 120px; height: 120px; display: flex; align-items: center; justify-content: center; overflow: hidden;">

                        <img id="imagePreview"
                             src="#"
                             alt="Product Image"
                             class="d-none"
                             style="width: 100%; height: 100%; object-fit: cover;" />

                        <div id="uploadPlaceholder" class="" text-center">
                            <i class="fas fa-image fa-2x text-muted mb-1"></i>
                            <span class="d-block text-muted" style="font-size: 11px; line-height: 1.2;">Select Image</span>
                        </div>

                        <button type="button"
                                id="removeImageBtn"
                                class="btn btn-danger btn-sm position-absolute d-none"
                                style="top: 3px; right: 3px; padding: 1px 6px; border-radius: 50%; font-size: 11px;"
                                onclick="removeSelectedImage();"
                                title="Remove Image">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>

                    <input asp-for="Image" type="file" id="imageInput" accept="image/*" class="form-control-file" onchange="previewImage(this);" />
                    <span asp-validation-for="Image" class="text-danger small"></span>
                </div>

                <hr/>

                <div class="d-flex justify-content-between p-2">
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-success">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>



<script>
    function previewImage(input) {
        const preview = document.getElementById('imagePreview');
        const placeholder = document.getElementById('uploadPlaceholder');
        const removeBtn = document.getElementById('removeImageBtn');

        if (input.files && input.files[0]) {
            const reader = new FileReader();

            reader.onload = function (e) {
                preview.src = e.target.result;
                preview.classList.remove('d-none');
                placeholder.classList.add('d-none');
                removeBtn.classList.remove('d-none');
            }

            reader.readAsDataURL(input.files[0]);
        }
    }

    function removeSelectedImage() {
        const preview = document.getElementById('imagePreview');
        const placeholder = document.getElementById('uploadPlaceholder');
        const removeBtn = document.getElementById('removeImageBtn');
        const input = document.getElementById('imageInput');

        preview.src = '#';
        preview.classList.add('d-none');
        placeholder.classList.remove('d-none');
        removeBtn.classList.add('d-none');

        input.value = '';
    }
</script>