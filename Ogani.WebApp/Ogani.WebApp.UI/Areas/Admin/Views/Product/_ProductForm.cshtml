@using Ogani.WebApp.DTOs.ProductDTO
@model IProductRequest

<div class="form-group mb-3">
    <label asp-for="Name" class="font-weight-bold"></label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger small"></span>
</div>

<div class="form-group mb-3">
    <label asp-for="Info" class="font-weight-bold"></label>
    <textarea asp-for="Info" class="form-control" rows="4"></textarea>
    <span asp-validation-for="Info" class="text-danger small"></span>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="form-group mb-3">
            <label asp-for="Price" class="font-weight-bold"></label>
            <input asp-for="Price" class="form-control" />
            <span asp-validation-for="Price" class="text-danger small"></span>
        </div>
    </div>

    <div class="col-md-4">
        <div class="form-group mb-3">
            <label asp-for="Quantity" class="font-weight-bold"></label>
            <input asp-for="Quantity" type="number" min="0" class="form-control"/>
            <span asp-validation-for="Quantity" class="text-danger small"></span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group mb-3">
            <label asp-for="Weight" class="font-weight-bold"></label>
            <input asp-for="Weight" class="form-control" />
            <span asp-validation-for="Weight" class="text-danger small"></span>
        </div>
    </div>
</div>

<div class="form-group mb-3">
    <label asp-for="Description" class="font-weight-bold"></label>
    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
    <span asp-validation-for="Description" class="text-danger small"></span>
</div>

<div class="form-group mb-3">
    @await Component.InvokeAsync("CategoryDropdown",
            new { selectedCategoryId = Model?.CategoryId })
</div>

<div class="form-group mb-3">
    @await Component.InvokeAsync("DiscountMultiSelect",
            new { selectedDiscountIds = Model?.DiscountIds })
</div>

<div class="form-check mb-3">
    <input asp-for="IsFeatured" class="form-check-input" />
    <label asp-for="IsFeatured" class="form-check-label font-weight-bold"></label>
</div>

<div class="form-check mb-3">
    <input asp-for="IsAvailable" class="form-check-input" />
    <label asp-for="IsAvailable" class="form-check-label font-weight-bold"></label>
</div>

