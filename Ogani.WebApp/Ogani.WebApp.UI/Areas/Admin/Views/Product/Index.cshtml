@using Ogani.WebApp.DTOs.ProductDTO
@model IReadOnlyCollection<ProductReadDTO>

<style>
    table th, table td {
        vertical-align: middle !important;
    }
</style>

<div class="container-fluid">

    <!-- Page Heading -->
    <h3 class="h3 mb-4 text-gray-800">Products</h3>

    <!-- DataTales Example -->
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">Products List</h6>
            @if (TempData["NotifySuccess"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
                    <i class="fas fa-check-circle mr-2"></i> @TempData["NotifySuccess"]
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            }

            @if (TempData["NotifyError"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                    <i class="fas fa-exclamation-triangle mr-2"></i> @TempData["NotifyError"]
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            }
            <a asp-action="Create" class="btn btn-success shadow-sm">New Product</a>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover text-center" width="100%">
                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>Name</th>
                            <th>CategoryName</th>
                            <th>Quantity</th>
                            <th>Price</th>
                            <th>Availablity</th>
                            <th>Featured</th>
                            <th>Created Date</th>
                            <th>Status</th>
                            <th class="col-2">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (ProductReadDTO item in Model)
                        {
                            <tr>
                                <td>
                                    <img style="width: 50px; height: 50px; object-fit: cover;" src="@item.ImageUrl" width="60" />
                                </td>
                                <td class="text-left">@item.Name</td>
                                <td class="text-left">@(item.CategoryName ?? "-")</td>
                                <td>@item.Quantity</td>
                                <td>@($"{item.Price:0.00} $")</td>
                                <td>
                                    <span class="badge @(item.IsAvailable ? "text-success" : "text-danger")">
                                        @(item.IsAvailable ? "Yes" : "No")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(item.IsFeatured ? "text-success" : "text-danger")">
                                        @(item.IsFeatured ? "Yes" : "No")
                                    </span>
                                </td>
                                <td class="text-muted small">@item.CreatedDate.ToString("dd.MM.yyyy - HH:mm:ss")</td>
                                <td>
                                    <span class="badge @(item.Status ? "text-success" : "text-danger")">
                                        @(item.Status ? "Active" : "Passive")
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex justify-content-center align-items-center">

                                        <a asp-action="Update" asp-route-id="@item.Id" class="btn btn-info btn-sm mr-2" title="edit">
                                            <i class="fas fa-pen-square"></i>
                                        </a>

                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure?');">
                                            <button type="submit" class="btn btn-danger btn-sm" title="delete">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>