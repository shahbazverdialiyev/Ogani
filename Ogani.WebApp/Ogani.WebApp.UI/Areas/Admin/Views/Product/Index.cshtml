@using Ogani.WebApp.DTOs.ProductDTO
@model IReadOnlyCollection<ProductReadDTO>

@section Styles {
    <link rel="stylesheet" href="~/admin/css/custom/product/product-index.css" />
}

<div class="container-fluid">

    <!-- Page Heading -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="h3 mb-0 text-gray-800 font-weight-bold">Products</h3>
        <a asp-action="Create" class="btn btn-success shadow-sm rounded-pill px-3">
            <i class="fas fa-plus mr-1"></i> New Product
        </a>
    </div>

    <!-- DataTales Example -->
    <div class="card shadow mb-4 border-0 rounded-lg">
        <div class="card-header py-3 d-flex justify-content-between align-items-center bg-white border-bottom-0">
            <h6 class="m-0 font-weight-bold text-primary">Products List</h6>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover text-center align-middle mb-0" width="100%">
                    <thead class="bg-light text-muted text-uppercase small font-weight-bold">
                        <tr>
                            <th class="border-top-0">Image</th>
                            <th class="border-top-0 text-left">Name</th>
                            <th class="border-top-0 text-left">Category</th>
                            <th class="border-top-0">Quantity</th>
                            <th class="border-top-0">Price</th>
                            <th class="border-top-0">Available</th>
                            <th class="border-top-0">Featured</th>
                            <th class="border-top-0">Created Date</th>
                            <th class="border-top-0">Status</th>
                            <th class="border-top-0">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="10" class="text-center py-5 text-muted">
                                    <i class="fas fa-box-open fa-3x mb-3 d-block"></i>
                                    <span>No products found.</span>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (ProductReadDTO item in Model)
                            {
                                <tr>
                                    <td>
                                        <a asp-action="Detail" asp-route-id="@item.Id">
                                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                                            {
                                                <img src="@item.ImageUrl" alt="@item.Name" class="rounded shadow-sm product-img" />
                                            }
                                            else
                                            {
                                                <div class="bg-light rounded d-inline-flex align-items-center justify-content-center product-img border">
                                                    <i class="fas fa-image text-muted"></i>
                                                </div>
                                            }
                                        </a>
                                    </td>

                                    <td class="text-left font-weight-bold">
                                        <a asp-action="Detail" asp-route-id="@item.Id" class="text-dark hover-link text-decoration-none">
                                            @item.Name
                                        </a>
                                    </td>

                                    <td class="text-left">
                                        @if (item.CategoryId != null && item.CategoryId > 0)
                                        {
                                            <a asp-controller="Category" asp-action="Detail" asp-route-id="@item.CategoryId" class="badge badge-light text-secondary border px-2 py-1 hover-link text-decoration-none">
                                                <i class="fas fa-folder mr-1 text-muted"></i>@(item.CategoryName ?? "-")
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="badge badge-light text-secondary text-muted border px-2 py-1">
                                                @(item.CategoryName ?? "none")
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.Quantity <= 5)
                                        {
                                            <span class="badge badge-soft-danger px-2 py-1">
                                                <i class="fas fa-exclamation-circle mr-1"></i>@item.Quantity (Low)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="font-weight-bold text-secondary">@item.Quantity</span>
                                        }
                                    </td>

                                    <td class="font-weight-bold text-success">
                                        $@item.Price.ToString("F2")
                                    </td>

                                    <td>
                                        @if (item.IsAvailable)
                                        {
                                            <span class="badge badge-soft-success"><i class="fas fa-check mr-1"></i>In Stock</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-soft-secondary"><i class="fas fa-times mr-1"></i>Out of Stock</span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.IsFeatured)
                                        {
                                            <i class="fas fa-star text-warning" title="Featured Product"></i>
                                        }
                                        else
                                        {
                                            <i class="far fa-star text-muted" title="Standard Product"></i>
                                        }
                                    </td>

                                    <td class="text-muted small">
                                        @item.CreatedDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        @if (item.Status)
                                        {
                                            <span class="badge badge-soft-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-soft-danger">Deactive</span>
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex justify-content-center align-items-center">
                                            <a asp-action="Detail" asp-route-id="@item.Id" class="btn btn-sm btn-light text-info mr-1 rounded-circle action-btn" title="Details">
                                                <i class="fas fa-info-circle"></i>
                                            </a>

                                            <a asp-action="Update" asp-route-id="@item.Id" class="btn btn-sm btn-light text-warning mr-1 rounded-circle action-btn" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>

                                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this product?');">
                                                <button type="submit" class="btn btn-sm btn-light text-danger rounded-circle action-btn" title="Delete">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>