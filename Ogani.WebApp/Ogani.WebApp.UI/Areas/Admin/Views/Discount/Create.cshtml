@using Ogani.WebApp.DTOs.DiscountDTO
@model DiscountCreateDTO

<div class="container-fluid">
    <div class="card mb-4 col-md-8 mx-auto shadow-sm border-0 rounded-lg">

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="card-header py-3 bg-white border-bottom-0">
                <h6 class="m-0 font-weight-bold text-primary">Create New Discount</h6>
            </div>

            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Discount Code -->
                <div class="form-group mb-3">
                    <label asp-for="Code" class="font-weight-bold">Code</label>
                    <input asp-for="Code" class="form-control text-uppercase" placeholder="e.g. SUMMER2026" autocomplete="off" />
                    <span asp-validation-for="Code" class="text-danger small"></span>
                </div>

                <!-- Discount Percentage -->
                <div class="form-group mb-3">
                    <label asp-for="DiscountPercentage" class="font-weight-bold">Discount Percentage (%)</label>
                    <div class="input-group">
                        <input asp-for="DiscountPercentage" type="number" step="0.01" min="0" max="100" class="form-control" placeholder="10.00" />
                        <div class="input-group-append">
                            <span class="input-group-text">%</span>
                        </div>
                    </div>
                    <span asp-validation-for="DiscountPercentage" class="text-danger small"></span>
                </div>

                <!-- Start Date -->
                <div class="form-group mb-3">
                    <label asp-for="StartDate" class="font-weight-bold">Start Date</label>
                    <input asp-for="StartDate" type="datetime-local" class="form-control" />
                    <span asp-validation-for="StartDate" class="text-danger small"></span>
                </div>

                <!-- End Date -->
                <div class="form-group mb-3">
                    <label asp-for="EndDate" class="font-weight-bold">End Date</label>
                    <input asp-for="EndDate" type="datetime-local" class="form-control" />
                    <span asp-validation-for="EndDate" class="text-danger small"></span>
                </div>

                <hr />

                <!-- Action Buttons -->
                <div class="d-flex justify-content-end">
                    <a asp-action="Index" class="btn btn-secondary rounded-pill px-4 mr-2">Cancel</a>
                    <button type="submit" class="btn btn-success rounded-pill px-4">Create</button>
                </div>
            </div>
        </form>

    </div>
</div>