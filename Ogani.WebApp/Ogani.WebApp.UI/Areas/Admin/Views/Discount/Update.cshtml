@using Ogani.WebApp.DTOs.DiscountDTO
@model DiscountUpdateDTO

<div class="container-fluid">
    <div class="card mb-4 col-md-8 mx-auto shadow-sm border-0 rounded-lg">

        <form asp-action="Update" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />

            <div class="card-header py-3 d-flex justify-content-between align-items-center bg-white border-bottom-0">
                <h6 class="m-0 font-weight-bold text-primary">Update Discount</h6>

                <div class="custom-control custom-switch">
                    <input asp-for="Status" type="checkbox" class="custom-control-input" id="categoryStatusSwitch">
                    <label class="custom-control-label font-weight-bold text-success cursor-pointer" for="categoryStatusSwitch">
                        Active
                    </label>
                </div>
            </div>

            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Discount Code (Readonly) -->
                <div class="form-group mb-3">
                    <label asp-for="Code" class="font-weight-bold">Code</label>
                    <input asp-for="Code" class="form-control text-uppercase bg-light" readonly />
                    <small class="form-text text-muted">Discount code cannot be changed once created.</small>
                </div>

                <!-- Discount Percentage -->
                <div class="form-group mb-3">
                    <label asp-for="DiscountPercentage" class="font-weight-bold">Discount Percentage (%)</label>
                    <div class="input-group">
                        <input asp-for="DiscountPercentage" type="number" step="0.01" min="0" max="100" class="form-control" placeholder="10.00" />
                        <div class="input-group-append">
                            <span class="input-group-text">%</span>
                        </div>
                    </div>
                    <span asp-validation-for="DiscountPercentage" class="text-danger small"></span>
                </div>

                <!-- Start Date -->
                <div class="form-group mb-3">
                    <label asp-for="StartDate" class="font-weight-bold">Start Date</label>
                    <input asp-for="StartDate" type="datetime-local" class="form-control" asp-format="{0:yyyy-MM-ddTHH:mm}" />
                    <span asp-validation-for="StartDate" class="text-danger small"></span>
                </div>

                <!-- End Date -->
                <div class="form-group mb-3">
                    <label asp-for="EndDate" class="font-weight-bold">End Date</label>
                    <input asp-for="EndDate" type="datetime-local" class="form-control" asp-format="{0:yyyy-MM-ddTHH:mm}" />
                    <span asp-validation-for="EndDate" class="text-danger small"></span>
                </div>

                <hr />

                <!-- Action Buttons -->
                <div class="d-flex justify-content-end">
                    <a asp-action="Index" class="btn btn-secondary rounded-pill px-4 mr-2">Cancel</a>
                    <button type="submit" class="btn btn-warning text-white rounded-pill px-4">Update</button>
                </div>
            </div>
        </form>

    </div>
</div>