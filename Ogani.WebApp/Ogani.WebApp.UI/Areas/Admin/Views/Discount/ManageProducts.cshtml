@using Ogani.WebApp.DTOs.DiscountDTO
@model DiscountProductsDTO

@section Styles {
    <link rel="stylesheet" href="~/admin/css/custom/discount/manage-discount-products.css" asp-append-version="true" />
}

<div class="container-fluid mb-5 pb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="h3 mb-0 text-gray-800">
            Manage Discount Products
        </h3>

        <a asp-action="Detail"
           asp-route-id="@Model.DiscountId"
           class="btn btn-secondary btn-sm rounded-pill px-3">
            <i class="fas fa-arrow-left mr-1"></i>
            Back
        </a>
    </div>

    <div class="card shadow mb-5">

        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">
                Select Products
            </h6>
        </div>

        <div class="card-body p-3">

            <form asp-action="ManageProducts" method="post" id="manage-products-form">

                <input type="hidden" asp-for="DiscountId" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="d-flex flex-wrap gap-3" style="gap: 15px;">

                    @foreach (var product in Model.Products)
                    {
                        bool isSelected = Model.SelectedProductIds.Contains(product.Id);

                        <div class="card shadow-sm border rounded overflow-hidden product-card @(isSelected ? "selected-card" : "")"
                             data-product-id="@product.Id"
                             style="width: 180px; flex: 0 0 180px; cursor: pointer; user-select: none;">

                            <!-- Product Image Container -->
                            <div class="position-relative overflow-hidden rounded-top" style="height: 180px; width: 180px;">

                                <!-- CHECKBOX -->
                                <div class="position-absolute" style="top: 8px; right: 8px; z-index: 10;">
                                    <div class="custom-control custom-checkbox pointer-events-none">
                                        <input type="checkbox"
                                               class="custom-control-input product-checkbox"
                                               id="product_@product.Id"
                                               name="SelectedProductIds"
                                               value="@product.Id"
                                        @(isSelected ? "checked" : "") />
                                        <label class="custom-control-label p-0" for="product_@product.Id"></label>
                                    </div>
                                </div>

                                @if (!string.IsNullOrEmpty(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl"
                                         class="card-img-top w-100 h-100 product-img"
                                         alt="@product.Name"
                                         style="object-fit: cover; transition: transform 0.3s ease;"
                                         loading="lazy" />
                                }
                                else
                                {
                                    <div class="w-100 h-100 bg-light d-flex align-items-center justify-content-center border-bottom">
                                        <i class="fas fa-box fa-2x text-muted opacity-50"></i>
                                    </div>
                                }

                            </div>

                            <!-- Product Details -->
                            <div class="card-body p-2 d-flex flex-column justify-content-between bg-white">

                                <h6 class="font-weight-bold text-dark mb-2 text-truncate small" style="max-width: 165px;">
                                    <a asp-controller="Product"
                                       asp-action="Detail"
                                       asp-route-id="@product.Id"
                                       target="_blank"
                                       class="text-dark text-decoration-none product-detail-link"
                                       title="@product.Name (@product.Id)">
                                        @product.Name
                                    </a>
                                </h6>

                                <div class="d-flex justify-content-between align-items-center">

                                    <span class="text-success font-weight-bold small">
                                        $@product.Price.ToString("0.00")
                                    </span>

                                    <span class="badge badge-light border text-muted small px-2 py-1">
                                        <i class="fas fa-cubes mr-1"></i>@product.Quantity
                                    </span>

                                </div>

                            </div>

                        </div>
                    }

                </div>

                <!-- FIXED BAR -->
                <div class="position-fixed bg-white border rounded-pill p-2 d-flex align-items-center floating-save-bar">

                    <div class="px-3 border-right">
                        <span class="small text-muted font-weight-bold text-uppercase d-block" style="font-size: 0.65rem;">Selected</span>
                        <span class="font-weight-bold text-primary" id="selected-count-badge">0 Products</span>
                    </div>

                    <a asp-action="Detail"
                       asp-route-id="@Model.DiscountId"
                       class="btn btn-sm btn-light rounded-pill px-3">
                        Cancel
                    </a>

                    <button type="submit" class="btn btn-sm btn-success rounded-pill px-4 font-weight-bold shadow-sm">
                        <i class="fas fa-save mr-1"></i>
                        Save Changes
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/admin/js/custom/discount/manage-discount-products.js" asp-append-version="true"></script>
}