@using Ogani.WebApp.DTOs.DiscountDTO
@model IReadOnlyCollection<DiscountReadDTO>

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="h3 mb-0 text-gray-800 font-weight-bold">Discounts</h3>
        <a asp-action="Create" class="btn btn-success rounded-pill px-4 shadow-sm">
            <i class="fas fa-plus mr-1"></i> New Discount
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-lg mb-4">
        <div class="card-header py-3 bg-white d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">Discounts List</h6>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered text-center align-middle mb-0" id="dataTable" width="100%" cellspacing="0">
                    <thead class="thead-light">
                        <tr>
                            <th style="width: 50px;">#</th>
                            <th>Code</th>
                            <th>Percentage</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Status</th>
                            <th style="width: 150px;" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            int count = 1;
                            foreach (var item in Model)
                            {
                                bool isActive = DateTime.Now >= item.StartDate && DateTime.Now <= item.EndDate;

                                <tr class="interactive-item" onclick="location.href='@Url.Action("Detail", "Discount", new { id = item.Id })'">
                                    <td class="font-weight-bold">@(count++)</td>
                                    <td>
                                        <span class="badge badge-secondary font-weight-bold p-2 text-uppercase">
                                            @item.Code
                                        </span>
                                    </td>
                                    <td>
                                        <span class="text-success font-weight-bold">
                                            %@item.DiscountPercentage.ToString("G29")
                                        </span>
                                    </td>
                                    <td>@item.StartDate.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>@item.EndDate.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>
                                        @if (isActive)
                                        {
                                            <span class="badge badge-success px-2 py-1">Active</span>
                                        }
                                        else if (DateTime.Now < item.StartDate)
                                        {
                                            <span class="badge badge-info px-2 py-1">Upcoming</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-danger px-2 py-1">Expired</span>
                                        }
                                    </td>
                                    <td class="text-center" onclick="event.stopPropagation();">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Update" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning mr-1 rounded" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this discount?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded" title="Delete">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">No discounts found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>