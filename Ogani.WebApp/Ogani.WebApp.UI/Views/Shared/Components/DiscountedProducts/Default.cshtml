@using Ogani.WebApp.DTOs.Client.ProductDTO
@model IReadOnlyCollection<ProductCardDTO>

<div class="section-title product__discount__title">
    <h2>Sale Off</h2>
</div>
<div class="row">
    <div class="product__discount__slider owl-carousel">

        @foreach (var product in Model)
        {
            <div class="col-lg-4">
                <div class="product__discount__item interactive-item" onclick="window.location.href='@Url.Action("Details","Shop", new { id = product.Id })'">
                    <div class="product__discount__item__pic set-bg" data-setbg="@product.ImageUrl">
                        <div class="product__discount__percent">-@product.DiscountPercentage%</div>
                        <ul class="product__item__pic__hover">
                            <li><a href="#"><i class="fa fa-heart"></i></a></li>
                            <li><a href="#"><i class="fa fa-retweet"></i></a></li>
                            <li><a href="#"><i class="fa fa-shopping-cart"></i></a></li>
                        </ul>
                    </div>
                    <div class="product__discount__item__text">
                        <span>@product.CategoryName</span>
                        <h5><a asp-controller="Shop" asp-action="Details" asp-route-id="@product.Id">@product.Name</a></h5>
                        <div class="product__item__price">$@product.DiscountedPrice.ToString("F2") <span>$@product.Price.ToString("F2")</span></div>
                    </div>
                </div>
            </div>
        }

    </div>
</div>