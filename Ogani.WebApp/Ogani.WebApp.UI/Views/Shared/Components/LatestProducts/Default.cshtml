@using Ogani.WebApp.DTOs.Client.ProductDTO
@model IReadOnlyCollection<ProductCardDTO>

<div class="latest-product__text">
    <h4>Latest Products</h4>
    <div class="latest-product__slider owl-carousel">
        <div class="latest-prdouct__slider__item">
            @foreach (var product in Model.Take(3))
            {
                <a asp-controller="Shop" asp-action="Details" asp-route-id="@product.Id" class="latest-product__item interactive-item">
                    <div class="latest-product__item__pic">
                        <img src="@product.ImageUrl" alt="product_image">
                    </div>
                    <div class="latest-product__item__text">
                        <h6>@product.Name</h6>
                        <span>@product.Price</span>
                    </div>
                </a>
            }
        </div>
        <div class="latest-prdouct__slider__item">
            @foreach (var product in Model.Skip(3).Take(3))
            {
                <a asp-controller="Shop" asp-action="Details" asp-route-id="@product.Id" class="latest-product__item interactive-item">
                    <div class="latest-product__item__pic">
                        <img src="@product.ImageUrl" alt="product_image">
                    </div>
                    <div class="latest-product__item__text">
                        <h6>@product.Name</h6>
                        <span>$@product.DiscountedPrice.ToString("F2")</span>
                    </div>
                </a>
            }
        </div>
    </div>
</div>