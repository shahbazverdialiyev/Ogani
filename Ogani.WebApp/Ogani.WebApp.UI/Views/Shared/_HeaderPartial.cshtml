@{
    var currentPath = Context.Request.Path + Context.Request.QueryString;
    var isAuthPage = Context.Request.Path.Value?.StartsWith("/Account/", StringComparison.OrdinalIgnoreCase) == true;

    var returnUrl = isAuthPage ? null : currentPath;
}

<header class="header">
    <div class="header__top">
        <div class="container">
            <div class="row">
                <div class="col-lg-6 col-md-6">
                    <div class="header__top__left">
                        <ul>
                            @await Component.InvokeAsync("Contacts")
                            <li>Free Shipping for all Order of $99</li>
                        </ul>
                    </div>
                </div>
                <div class="col-lg-6 col-md-6">
                    <div class="header__top__right">
                        @await Component.InvokeAsync("SocialLinks")

                        <div class="header__top__right__language">
                            <img src="~/assets/img/language.png" alt="Language">
                            <div>English</div>
                            <span class="arrow_carrot-down"></span>
                            <ul>
                                <li><a href="#">Spanish</a></li>
                                <li><a href="#">English</a></li>
                            </ul>
                        </div>

                        @if (!isAuthPage)
                        {
                            <div class="header__top__right__auth">
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <div class="header__top__right__language">
                                        <i class="fa fa-user"></i>
                                        <span class="arrow_carrot-down"></span>
                                        <ul style="width: 150px;">
                                            @if (User.IsInRole("Admin"))
                                            {
                                                <li>
                                                    <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="text-danger fw-bold">
                                                        <i class="fa fa-cogs"></i> Admin Panel
                                                    </a>
                                                </li>
                                            }
                                            <li>
                                                <a asp-area="" asp-controller="Account" asp-action="Profile">
                                                    <i class="fa fa-id-card"></i> My Profile
                                                </a>
                                            </li>
                                            <li>
                                                <form asp-area="" asp-controller="Account" asp-action="Logout" asp-route-returnUrl="@returnUrl" method="post" id="clientLogoutForm" class="d-none"></form>
                                                <a href="javascript:void(0);" onclick="document.getElementById('clientLogoutForm').submit();" class="text-danger">
                                                    <i class="fa fa-sign-out"></i> Logout
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                }
                                else
                                {
                                    <a asp-area="" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl">
                                        Login
                                    </a>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="container">
        <div class="row">
            <div class="col-lg-3">
                <div class="header__logo">
                    <a asp-controller="Home" asp-action="Index">
                        <img src="~/assets/img/logo.png" alt="Ogani Logo">
                    </a>
                </div>
            </div>
            <div class="col-lg-6">
                <nav class="header__menu">
                    <ul>
                        <li class="@(ViewBag.ActivePage == "Home" ? "active" : "")">
                            <a asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="@(ViewBag.ActivePage == "Shop" ? "active" : "")">
                            <a asp-controller="Shop" asp-action="Index">Shop</a>
                        </li>
                        <li class="@(ViewBag.ActivePage == "Blog" ? "active" : "")">
                            <a asp-controller="Blog" asp-action="Index">Blog</a>
                        </li>
                        <li class="@(ViewBag.ActivePage == "Contact" ? "active" : "")">
                            <a asp-controller="Contact" asp-action="Index">Contact</a>
                        </li>
                    </ul>
                </nav>
            </div>
            <div class="col-lg-3">
                <div class="header__cart">
                    <ul>
                        <li><a href="#"><i class="fa fa-heart"></i> <span>1</span></a></li>
                        <li><a href="#"><i class="fa fa-shopping-bag"></i> <span>3</span></a></li>
                    </ul>
                    <div class="header__cart__price">item: <span>$150.00</span></div>
                </div>
            </div>
        </div>
        <div class="humberger__open">
            <i class="fa fa-bars"></i>
        </div>
    </div>
</header>