@using Ogani.WebApp.DTOs.Client
@using Ogani.WebApp.DTOs.Client.ProductDTO
@model PagedResultDTO<ProductCardDTO>

<!-- Hero Section Begin -->
<section class="hero">
    <div class="container">
        <div class="row">
            <div class="col-lg-3">
            </div>
            <div class="col-lg-9">
                <div class="hero__search">

                    <partial name="_HeroSearchPartial" />


                </div>
            </div>
        </div>
    </div>
</section>
<!-- Hero Section End -->
<!-- Breadcrumb Section Begin -->
<section class="breadcrumb-section set-bg" data-setbg="/assets/img/breadcrumb.jpg">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center">
                <div class="breadcrumb__text">
                    <h2>Organi Shop</h2>
                    <div class="breadcrumb__option">
                        <a asp-controller="Home">Home</a>
                        <span>@(ViewBag.ActivePage = "Shop")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Breadcrumb Section End -->
<!-- Product Section Begin -->
<section class="product spad">
    <div class="container">
        <form id="shop-filter-form" asp-controller="Shop" asp-action="ProductsRow" method="get">

            <div class="row mb-5 pb-5" id="products-row">
                @await Html.PartialAsync(
                         "_ProductsRowPartial",
                         Model)
            </div>

        </form>
        <hr />
        <div class="row mt-5">
            <div class="col-lg-9 col-md-7 mx-auto">
                <div class="product__discount">

                    @await Component.InvokeAsync("DiscountedProducts")

                </div>
            </div>
        </div>
    </div>
</section>
<!-- Product Section End -->
@section Scripts {
    <script src="/assets/js/custom/products-filter.js"></script>
}