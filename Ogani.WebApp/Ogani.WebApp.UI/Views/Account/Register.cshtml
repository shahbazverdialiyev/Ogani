@using Ogani.WebApp.UI.Models.Account
@model RegisterVM

@{
    ViewData["Title"] = "Registration";
}

<link rel="stylesheet" href="~/assets/css/account.css" />

<!-- Breadcrumb Section Begin -->
<section class="breadcrumb-section set-bg" data-setbg="/assets/img/breadcrumb.jpg">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center">
                <div class="breadcrumb__text">
                    <h2>Register</h2>
                    <div class="breadcrumb__option">
                        <a asp-controller="Home" asp-action="Index">Home</a>
                        <span>Registration</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Breadcrumb Section End -->
<!-- Register Form Begin -->
<div class="contact-form spad">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8">
                <div class="contact__form__title text-center mb-4">
                    <h2>Create New Account</h2>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success text-center mb-4">
                        @TempData["SuccessMessage"]
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger text-center mb-4">
                        @TempData["ErrorMessage"]
                    </div>
                }

                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-group mb-3">
                        <label asp-for="UserName" class="form-label font-weight-bold">Username</label>
                        <input asp-for="UserName" class="form-control" placeholder="Choose a username" />
                        <span asp-validation-for="UserName" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 form-group mb-3">
                            <label asp-for="FirstName" class="form-label font-weight-bold">First Name</label>
                            <input asp-for="FirstName" class="form-control" placeholder="First Name" />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 form-group mb-3">
                            <label asp-for="LastName" class="form-label font-weight-bold">Last Name</label>
                            <input asp-for="LastName" class="form-control" placeholder="Last Name" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Email" class="form-label font-weight-bold">Email Address</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="example@domain.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Password" class="form-label font-weight-bold">Password</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Enter password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="ConfirmPassword" class="form-label font-weight-bold">Confirm Password</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Re-enter password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <button type="submit" class="site-btn w-100">Register</button>
                </form>

                <div class="text-center mt-4">
                    <p>Already have an account? <a asp-action="Login" class="auth-link">Login here</a></p>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Register Form End -->