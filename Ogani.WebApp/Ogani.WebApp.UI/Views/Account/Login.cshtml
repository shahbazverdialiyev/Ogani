@using Ogani.WebApp.UI.Models.Account
@model LoginVM

@{
    ViewData["Title"] = "Login";
}

<link rel="stylesheet" href="~/assets/css/account.css" />

<!-- Breadcrumb Section Begin -->
<section class="breadcrumb-section set-bg" data-setbg="/assets/img/breadcrumb.jpg">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center">
                <div class="breadcrumb__text">
                    <h2>Login</h2>
                    <div class="breadcrumb__option">
                        <a asp-controller="Home" asp-action="Index">Home</a>
                        <span>Login</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Breadcrumb Section End -->
<!-- Login Form Begin -->
<div class="contact-form spad">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8">
                <div class="contact__form__title text-center mb-4">
                    <h2>Welcome Back</h2>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success text-center mb-4">
                        @TempData["SuccessMessage"]
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger text-center mb-4">
                        @TempData["ErrorMessage"]
                    </div>
                }

                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-group mb-3">
                        <label asp-for="UserNameOrEmail" class="form-label font-weight-bold">Username or Email</label>
                        <input asp-for="UserNameOrEmail" class="form-control" placeholder="Enter username or email" />
                        <span asp-validation-for="UserNameOrEmail" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Password" class="form-label font-weight-bold">Password</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Enter password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" style="height:initial;width:initial;" />
                            <label asp-for="RememberMe" class="form-check-label">Remember me</label>
                        </div>
                        <a asp-action="ForgotPassword" class="auth-link small">Forgot password?</a>
                    </div>

                    <button type="submit" class="site-btn w-100">Login</button>
                </form>

                <div class="text-center mt-4">
                    <p>Don't have an account? <a asp-action="Register" class="auth-link">Create Account</a></p>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Login Form End -->