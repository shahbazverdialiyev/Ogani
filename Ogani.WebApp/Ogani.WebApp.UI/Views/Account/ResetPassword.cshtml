@using Ogani.WebApp.UI.Models.Account
@model ResetPasswordVM

@{
    ViewData["Title"] = "Reset Password";
}

<link rel="stylesheet" href="~/assets/css/account.css" />

<!-- Breadcrumb Section Begin -->
<section class="breadcrumb-section set-bg" data-setbg="/assets/img/breadcrumb.jpg">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center">
                <div class="breadcrumb__text">
                    <h2>New Password</h2>
                    <div class="breadcrumb__option">
                        <a asp-controller="Home" asp-action="Index">Home</a>
                        <span>Reset Password</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Breadcrumb Section End -->
<!-- Reset Password Form Begin -->
<div class="contact-form spad">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8">
                <div class="contact__form__title text-center mb-4">
                    <h2>Reset Your Password</h2>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success text-center mb-4">
                        @TempData["SuccessMessage"]
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger text-center mb-4">
                        @TempData["ErrorMessage"]
                    </div>
                }

                <form asp-action="ResetPassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Token" />

                    <div class="form-group mb-3">
                        <label asp-for="NewPassword" class="form-label font-weight-bold">New Password</label>
                        <input asp-for="NewPassword" type="password" class="form-control" placeholder="Enter new password" />
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="ConfirmNewPassword" class="form-label font-weight-bold">Confirm New Password</label>
                        <input asp-for="ConfirmNewPassword" type="password" class="form-control" placeholder="Re-enter new password" />
                        <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
                    </div>

                    <button type="submit" class="site-btn w-100">Reset Password</button>
                </form>
            </div>
        </div>
    </div>
</div>
<!-- Reset Password Form End -->