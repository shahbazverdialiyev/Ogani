@using Ogani.WebApp.DTOs.Auth
@model ForgotPasswordDTO

@{
    ViewData["Title"] = "Forgot Password";
}

<link rel="stylesheet" href="~/assets/css/account.css" />

<!-- Breadcrumb Section Begin -->
<section class="breadcrumb-section set-bg" data-setbg="/assets/img/breadcrumb.jpg">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center">
                <div class="breadcrumb__text">
                    <h2>Password Recovery</h2>
                    <div class="breadcrumb__option">
                        <a asp-controller="Home" asp-action="Index">Home</a>
                        <span>Forgot Password</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Breadcrumb Section End -->

<!-- Forgot Password Form Begin -->
<div class="contact-form spad">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8">
                <div class="contact__form__title text-center mb-4">
                    <h2>Forgot Password?</h2>
                    <p class="text-muted small">Enter your username or email address below and we'll send you a link to reset your password.</p>
                </div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success text-center mb-4">
                        @TempData["SuccessMessage"]
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger text-center mb-4">
                        @TempData["ErrorMessage"]
                    </div>
                }

                <form asp-action="ForgotPassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-group mb-4">
                        <label asp-for="UserNameOrEmail" class="form-label font-weight-bold">Username or Email Address</label>
                        <input asp-for="UserNameOrEmail" class="form-control" placeholder="Enter your username or email" />
                        <span asp-validation-for="UserNameOrEmail" class="text-danger"></span>
                    </div>

                    <button type="submit" class="site-btn w-100 mb-3">Send Reset Link</button>
                    <a asp-action="Login" class="site-btn site-btn-secondary w-100 text-center d-inline-block">Back to Login</a>
                </form>
            </div>
        </div>
    </div>
</div>
<!-- Forgot Password Form End -->